// Copy to wrangler.instance.jsonc (gitignored) and fill in your own values.
// Deploy with: wrangler deploy -c wrangler.instance.jsonc
{
  "name": "linkwarren",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  // Built dashboard (npm run build:web first). run_worker_first must stay true: short hosts must never be answered by the asset layer.
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "linkwarren", "database_id": "<your-d1-database-id>", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "<your-kv-namespace-id>" }],
  "vars": {
    "DASHBOARD_HOST": "dash.example.com",
    // "app" (linkwarren's own sign-in, the default) or "access" (Cloudflare Access). See docs/deploy.md "Sign-in".
    "AUTH_MODE": "app",
    // App mode: sign-in email sender. The key is a secret: wrangler secret put RESEND_API_KEY -c wrangler.instance.jsonc
    "EMAIL_FROM": "links@example.com",
    // Access mode only:
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": "<your-access-application-aud-tag>"
    // OWNER_EMAIL is a secret, never a var: wrangler secret put OWNER_EMAIL -c wrangler.instance.jsonc
  },
  // Add one route per short domain, plus the dashboard host.
  "routes": [
    { "pattern": "dash.example.com", "custom_domain": true },
    { "pattern": "go.example.com", "custom_domain": true }
  ]
}
