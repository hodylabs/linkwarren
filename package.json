{
  "name": "linkwarren",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.instance.jsonc",
    "dev:web": "vite web",
    "build:web": "vite build web && npm run check:web",
    "check:web": "test -f web/dist/index.html && ! grep -rl 'data:font' web/dist",
    "test": "vitest run && vitest run -c web/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@simplewebauthn/server": "14.1.0",
    "agents": "~0.33.0",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "uqr": "0.1.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
